@inherits LayoutComponentBase

<div class="d-flex flex-column bg-dark" style="max-height: 100vh; overflow-y:hidden;">
    <header>
        <nav class="navbar navbar-expand bg-primary bg-gradient navbar-dark text-white px-md-2 pt-0 pb-1 py-md-2">
            <div class="container-fluid">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <div>
                        <a class="navbar-brand me-1 d-block d-md-inline" href="/"><Blazicon Svg="@Logo"></Blazicon>Blazicons</a>
                        <span class="tagline d-none d-lg-inline">Icon Component Libraries for Blazor</span>
                    </div>
                    <ul class="navbar-nav site-nav d-none d-md-flex align-items-center gap-2">
                        <li class="nav-item">
                            <NavLink href="/icons" class="nav-link" Match="NavLinkMatch.All"><Blazicon Svg="MdiIcon.Magnify" /> Icons</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink href="/layers" class="nav-link" Match="NavLinkMatch.All"><Blazicon Svg="MdiIcon.Layers" /> Layers</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink href="/animations" class="nav-link" Match="NavLinkMatch.All"><Blazicon Svg="MdiIcon.Play" /> Animations</NavLink>
                        </li>
                    </ul>
                    <div class="text-end pe-0">
                        <ul class="navbar-nav justify-content-end">
                            <li class="nav-item">
                                <a href="https://github.com/kyleherzog/Blazicons#overview" target="_blank" title="Help/Documentation" class="nav-link"><Blazicon Svg="MdiIcon.HelpCircle" /></a>
                            </li>
                            <li class="nav-item">
                                <a href="https://github.com/kyleherzog/Blazicons" target="_blank" title="GitHub Repo" class="nav-link"><Blazicon Svg="MdiIcon.Github" /></a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="flex-fill">@Body</div>
</div>
